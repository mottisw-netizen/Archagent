<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoCAD 2024/Civil 3D 2024 host .NET Framework 4.8; this file targets that.
    Civil 3D is AutoCAD with an additional API layer, so the same DLL loads into
    either host - it only ever touches the plain AutoCAD object model (entities,
    layers, blocks), never a Civil 3D-specific object (alignment, corridor,
    pipe network). See README.md for what that means in practice.

    AcCoreMgd.dll / AcDbMgd.dll / AcMgd.dll ship with AutoCAD; they are
    referenced from the install directory and never copied into the output,
    because the add-in is loaded *into* AutoCAD's own process where those
    assemblies already live.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>false</UseWPF>
    <AssemblyName>Archagent.AutoCAD</AssemblyName>
    <RootNamespace>Archagent.Acad</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <AcadVersion Condition="'$(AcadVersion)' == ''">2024</AcadVersion>
    <AcadPath Condition="'$(AcadPath)' == ''">C:\Program Files\Autodesk\AutoCAD $(AcadVersion)</AcadPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Archagent</Company>
    <Product>Archagent AutoCAD/Civil 3D host</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      JSON via System.Web.Extensions, exactly as in revit-addin/: whichever
      host this loads into may carry its own Newtonsoft.Json, and a second
      copy in the same process is a well-known way to crash an add-in.
    -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Archagent.bundle\PackageContents.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy the built DLL into the .bundle so ApplicationPlugins autoloads it. -->
  <Target Name="InstallBundle" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <BundleDir>$(AppData)\Autodesk\ApplicationPlugins\Archagent.bundle\Contents</BundleDir>
    </PropertyGroup>
    <MakeDir Directories="$(BundleDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BundleDir)" />
    <Copy SourceFiles="$(ProjectDir)Archagent.bundle\PackageContents.xml"
          DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\Archagent.bundle" />
  </Target>

</Project>
