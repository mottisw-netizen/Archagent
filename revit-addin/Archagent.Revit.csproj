<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit 2024 hosts .NET Framework 4.8. Revit 2025 and later host .NET 8, so a
    2025+ build changes this file (TargetFramework net8.0-windows) and nothing
    else in the sources except the two places marked REVIT2025 in HostServer.cs.

    RevitAPI.dll and RevitAPIUI.dll ship with Revit; they are referenced from the
    install directory and never copied into the output, because the add-in is
    loaded *into* Revit's own process where those assemblies already live.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>false</UseWPF>
    <AssemblyName>Archagent.Revit</AssemblyName>
    <RootNamespace>Archagent.Revit</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <RevitPath Condition="'$(RevitPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Archagent</Company>
    <Product>Archagent Revit host</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      JSON via System.Web.Extensions (part of .NET Framework) rather than
      Newtonsoft: Revit loads its own Newtonsoft.Json, and shipping a second
      copy into the same process is a classic add-in crash.
    -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Archagent.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy the add-in into the user's Revit add-ins folder on build. -->
  <Target Name="InstallAddin" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)\Archagent" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinDir)\Archagent" />
    <Copy SourceFiles="$(ProjectDir)Archagent.addin" DestinationFolder="$(AddinDir)" />
  </Target>

</Project>
